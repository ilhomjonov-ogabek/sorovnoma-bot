<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

  <changeSet id="002-create-transactions-table" author="developer">
    <createTable tableName="transactions">

      <column name="transaction_id" type="UUID">
        <constraints primaryKey="true" nullable="false"/>
      </column>

      <column name="external_id" type="VARCHAR(255)">
        <constraints nullable="false"/>
      </column>

      <column name="card_id" type="UUID">
        <constraints nullable="false"
          foreignKeyName="fk_transactions_card_id"
          references="cards(card_id)"/>
      </column>

      <column name="type" type="VARCHAR(10)">
        <constraints nullable="false"/>
      </column>

      <column name="amount" type="BIGINT">
        <constraints nullable="false"/>
      </column>

      <column name="after_balance" type="BIGINT">
        <constraints nullable="false"/>
      </column>

      <column name="currency" type="VARCHAR(10)">
        <constraints nullable="false"/>
      </column>

      <column name="purpose" type="VARCHAR(20)">
        <constraints nullable="true"/>
      </column>

      <column name="exchange_rate" type="BIGINT">
        <constraints nullable="true"/>
      </column>

      <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
        <constraints nullable="false"/>
      </column>

    </createTable>

    <createIndex tableName="transactions" indexName="idx_transactions_card_id">
      <column name="card_id"/>
    </createIndex>

    <createIndex tableName="transactions" indexName="idx_transactions_external_id">
      <column name="external_id"/>
    </createIndex>

    <createIndex tableName="transactions" indexName="idx_transactions_type">
      <column name="type"/>
    </createIndex>

  </changeSet>

</databaseChangeLog>